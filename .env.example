# ==============================================
# AI API 配置
# ==============================================

# DeepSeek API Key
# 获取后填入服务端环境变量，前端不会直接暴露此值
DEEPSEEK_API_KEY=sk-xxxx

# DeepSeek 模型名，可按需切换
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 域名，默认即可
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==============================================
# 服务端口
# ==============================================

WORDS_APP_PORT=8080

# ==============================================
# 用户系统（可选，保留默认值即可）
# ==============================================

# 默认单词本用户 ID，未登录时使用
# 如果是个人部署，建议改成自己的固定 ID，比如你的邮箱或者用户名
DEFAULT_WORDS_USER_ID=demo-user
VITE_WORDS_USER_ID=demo-user
